{
  "name": "cubetrainer",
  "private": true,
  "type": "module",
  "description": "Personal cubing tools. One npm install here installs every workspace; see README.md.",
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "app",
    "server",
    "tools/f2l/catalog/builder",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "server": "npm run dev -w server",
    "build": "tsc -p server/tsconfig.json && npm run build -w app",
    "check:imports": "node scripts/check-imports.ts",
    "new-tool": "node --disable-warning=ExperimentalWarning scripts/new-tool.ts",
    "data:pull": "node --disable-warning=ExperimentalWarning scripts/data.ts pull",
    "data:diff": "node --disable-warning=ExperimentalWarning scripts/data.ts diff",
    "data:push": "node --disable-warning=ExperimentalWarning scripts/data.ts push",
    "test": "node --disable-warning=ExperimentalWarning --test server/src/*.test.ts server/src/*/*.test.ts tools/*/server/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc -p server/tsconfig.json && tsc -b app",
    "lint": "npm run lint -w app",
    "check": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
