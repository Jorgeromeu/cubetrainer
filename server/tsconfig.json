{
  // Type check only: Node runs the .ts files directly (type stripping), so nothing is emitted.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../packages/core", "../tools/*/contract.ts", "../tools/*/server", "../tools/*/catalog/*.ts", "../scripts/devenv.ts", "../scripts/datasync.ts"]
}
